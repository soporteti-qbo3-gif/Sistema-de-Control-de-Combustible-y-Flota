# ==============================================================================
# PagSurr / Sistema de Gestión y Control - Variables de Entorno de Ejemplo
# ==============================================================================

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Puerto en el que se ejecuta el servidor backend (Node.js / Express)
PORT=3000

# URL pública base del backend API consumida por el cliente frontend (Vite)
VITE_API_URL=http://localhost:3000/api

# URL canónica del sitio para metadatos, sitemaps y configuración de host
VITE_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SECRETOS DEL SERVIDOR (¡CRÍTICO DE SEGURIDAD!)
# NUNCA usar prefijo VITE_ en estas variables.
# NUNCA exponer GEMINI_API_KEY en el cliente frontend ni commitear valores reales.
# ------------------------------------------------------------------------------

# Clave secreta para firma y verificación de tokens JWT (OBLIGATORIA en producción)
# generar con: openssl rand -base64 48
JWT_SECRET=

# API Key de Google Gemini para procesamiento OCR y extracción inteligente de tickets
GEMINI_API_KEY=

# Directorio persistente de almacenamiento de base de datos JSON (opcional, por defecto raíz)
# Para contenedores Docker: /app/data
DATA_DIR=

# Observabilidad y Monitoreo de Errores (Sentry)
SENTRY_DSN=

# Servicio de Correo Electrónico Transaccional y Alertas Anti-Fraude (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Control de Flota <alertas@flota.com>
